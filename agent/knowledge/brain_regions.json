  "regions": {
    "HIP": {
      "abbr": "HIP",
      "cn_name": "海马",
      "en_name": "Hippocampus",
      "aal_index": [37, 38],
      "functions": "情景记忆编码与巩固，空间导航",
      "ad_relevance": "AD最早且最显著的萎缩脑区。MCI阶段海马体积减少约10-15%，AD痴呆阶段减少20-30%。海马萎缩程度与Braak分期高度相关（Braak II期即有NFT沉积）。",
      "rs_fmri": "海马-默认网络功能连接受损是MCI进展的早期标志",
      "clinical": "海马体积是FDA批准的AD临床试验替代终点之一"
    },
    "PHG": {
      "abbr": "PHG",
      "cn_name": "海马旁回",
      "en_name": "Parahippocampal Gyrus",
      "aal_index": [39, 40],
      "functions": "空间记忆与场景识别，海马信息的输入门控",
      "ad_relevance": "与海马共同构成内侧颞叶记忆系统。AD中PHG皮层厚度显著降低，且与tau蛋白沉积密切相关。MCI阶段PHG的功能连接异常可预测2年内向AD的转化。",
      "rs_fmri": "PHG-后扣带回功能连接减弱"
    },
    "AMYG": {
      "abbr": "AMYG",
      "cn_name": "杏仁核",
      "en_name": "Amygdala",
      "aal_index": [41, 42],
      "functions": "情绪记忆（特别是恐惧条件反射），社会认知",
      "ad_relevance": "在AD进展中萎缩程度仅次于海马。杏仁核体积与AD行为心理症状（BPSD）严重度相关。早期与嗅皮层同步出现NFT。",
      "clinical": "杏仁核萎缩在早发型AD中尤为突出"
    },
    "PCG": {
      "abbr": "PCG",
      "cn_name": "后扣带回",
      "en_name": "Posterior Cingulate Cortex",
      "aal_index": [35, 36],
      "functions": "默认模式网络 (DMN) 核心枢纽，自传体记忆提取",
      "ad_relevance": "AD中最早出现代谢降低的区域（FDG-PET），甚至在结构萎缩之前。后扣带回是DMN的关键节点，其在rs-fMRI中的功能连接异常是AD临床前阶段的敏感标志。",
      "rs_fmri": "PCG-海马、PCG-楔前叶功能连接下降",
      "clinical": "PCG代谢降低是AD与其他痴呆鉴别的关键特征",
      "aliases": ["PCC"]
    },
    "ACG": {
      "abbr": "ACG",
      "cn_name": "前扣带回",
      "en_name": "Anterior Cingulate Cortex",
      "aal_index": [31, 32],
      "functions": "注意控制、错误监测、情感调节",
      "ad_relevance": "MCI中已出现ACG功能异常，表现为在认知任务中激活增加（代偿机制）。AD晚期ACG体积萎缩。前扣带回是突显网络(Salience Network)的核心。",
      "clinical": "ACG功能连接异常与MCI的注意和执行功能障碍相关"
    },
    "PCUN": {
      "abbr": "PCUN",
      "cn_name": "楔前叶",
      "en_name": "Precuneus",
      "aal_index": [67, 68],
      "functions": "自传体记忆、视空间想象、自我意识",
      "ad_relevance": "楔前叶是AD中淀粉样蛋白沉积最早期和最严重的区域之一。其在rs-fMRI中的功能连接下降先于结构改变。楔前叶代谢降低是后部皮层萎缩型AD的特征。",
      "rs_fmri": "楔前叶-DMN内功能连接下降"
    },
    "SFGdor": {
      "abbr": "SFGdor",
      "cn_name": "额上回背外侧部",
      "en_name": "Superior Frontal Gyrus (Dorsolateral)",
      "aal_index": [3, 4],
      "functions": "执行功能、工作记忆、计划",
      "ad_relevance": "晚期AD萎缩区域。MCI阶段可见额上回功能代偿性激活增加（认知储备的表现）。额叶储备较高的个体在同等病理负担下症状更轻。",
      "clinical": "额叶功能保留程度与认知储备相关"
    },
    "STG": {
      "abbr": "STG",
      "cn_name": "颞上回",
      "en_name": "Superior Temporal Gyrus",
      "aal_index": [81, 82],
      "functions": "听觉处理、语言理解（Wernicke区部分）",
      "ad_relevance": "AD中颞上回萎缩是语言功能障碍的结构基础。STG与AD中听觉信息处理障碍和语言流畅性下降相关。",
      "rs_fmri": "左侧STG功能连接下降与命名障碍相关"
    },
    "MTG": {
      "abbr": "MTG",
      "cn_name": "颞中回",
      "en_name": "Middle Temporal Gyrus",
      "aal_index": [85, 86],
      "functions": "语义记忆、语言处理、视觉运动感知",
      "ad_relevance": "左侧MTG在AD早期出现代谢下降。MTG萎缩与语义记忆障碍密切相关，是AD与语义性痴呆鉴别的关键区域。",
      "rs_fmri": "MTG-DMN功能连接减弱"
    },
    "FFG": {
      "abbr": "FFG",
      "cn_name": "梭状回",
      "en_name": "Fusiform Gyrus",
      "aal_index": [55, 56],
      "functions": "面孔识别、物体识别、阅读（视觉词形区）",
      "ad_relevance": "右侧FFG与AD患者的面孔识别障碍相关。AD晚期梭状回萎缩显著。后部皮层萎缩型AD常累及梭状回。",
      "clinical": "FFG功能完整性与社会认知功能保留相关"
    },
